# https://editorconfig.org — solo lo que ya usa el código; no obliga a reformatear archivos existentes.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Terceros: se dejan como vienen.
[vendor/**]
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
